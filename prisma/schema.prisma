generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exercise {
  id                       String        @id @default(cuid())
  title                    String
  description              String
  image                    String
  referenceVideoUrl        String?
  referenceKeypointsUrl    String
  tags                     String
  equipment                String
  level                    String
  muscleGroups             String
  jointsOfInterest         String
  createdBy                String
  dateAdded                DateTime      @default(now())
  instructions             String
  authorName               String
  authorProfileUrl         String?
  relatedExercises         String
  exerciseType             String        @default("repetition")
  exerciseSubtype          String?
  classificationConfidence Float?
  poseAnalysis             PoseAnalysis?
  repAnalysis              RepAnalysis?
}

model RepAnalysis {
  id               String   @id @default(cuid())
  exerciseId       String   @unique
  goldStandardRep  String?
  repBoundaries    String?
  adminNotes       String?
  jointAngleRules  String?
  validatedByAdmin Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  exercise         Exercise @relation(fields: [exerciseId], references: [id])
}

model PoseAnalysis {
  id                   String   @id @default(cuid())
  exerciseId           String   @unique
  targetPoses          String
  angleRanges          String
  primaryJoints        String?
  toleranceMultipliers String?
  feedbackMessages     String?
  adminNotes           String?
  validatedByAdmin     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  exercise             Exercise @relation(fields: [exerciseId], references: [id])
}

model CuratedSection {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  exercises   String
}

model FeaturedContent {
  id          String   @id @default(cuid())
  title       String
  description String
  heroImage   String
  exerciseId  String?
  ctaText     String   @default("Try Now")
  ctaUrl      String?
  badgeText   String   @default("Featured Exercise")
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
